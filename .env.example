# Copy to .env and set your bot token (do not commit .env)
DISCORD_TOKEN=your_bot_token_here
# Optional: custom word list path
# WORDS_FILE=words.txt
# Channel where the bot LISTENS (slurs, off-topic, religion/politics, Soon) = gv-general. Leave unset to use default. Do NOT set to off-topic.
# TRIGGER_CHANNEL_ID=1166738417539887218
# Where bot-moved gv-general messages are reposted (keeps #off-topic chat clean). Default: 1485211311070511225
# MOVED_BY_BOT_CHANNEL_ID=1485211311070511225
# If Chronicus/off-topic education cannot be DM’d after a rule hit, post it here (default 1485211311070511225)
# CHRONICUS_EDUCATION_DM_FALLBACK_CHANNEL_ID=1485211311070511225
# #off-topic ID — Chronicus + “please continue here” still point here (default: 1168446788810842172)
# REDIRECT_CHANNEL_ID=1168446788810842172
# Optional: set to 1 or true to log why messages were skipped (wrong channel, empty content, safe-context, no trigger word)
# DEBUG=1

# Optional: "monkey emoji vs moderation/guild threat" meme reactions in gv-general (default random: 🐒 🐵 🦍 — :monkey: :monkey_face: :gorilla:)
# MONKEY_TROPE_EMOJIS=🐒,🐵,🦍
# MONKEY_TROPE_EMOJI=<:monkey:1234567890123456789>

# Slur response: bot replies with this video (first offense). Use a direct, playable URL (e.g. from your host or CDN).
# If set, VIDEO_URL is used; otherwise VIDEO_PATH (local file path) is used.
# VIDEO_URL=https://example.com/path/to/TMFIAR.mp4
# VIDEO_PATH=C:\Users\serje\Downloads\TMFIAR.mp4

# "Poor … Savage" in gv-general → bot replies with this video (default: assets/The_Way_We_Raid_Gloria_Victis.mp4)
# POOR_SAVAGE_VIDEO_PATH=C:\Users\serje\Downloads\The_Way_We_Raid_Gloria_Victis.mp4

# New member join: post this video in gv-general (default: Knights with sub)
# NEW_ARRIVAL_VIDEO_URL=https://streamable.com/vxi8bu
# Channel to post the welcome video (default: same as TRIGGER_CHANNEL_ID / gv-general)
# GV_GENERAL_CHANNEL_ID=1166738417539887218
# Admin channel that receives join notifications; bot welcomes mentioned user in gv-general when it sees "joined"/"welcome" there
# ADMIN_JOIN_CHANNEL_ID=1166746316999757864

# User ID whose image/GIF posts in off-topic are moved to gv-general. Set in Render only — do not commit real IDs.
# OFFTOPIC_TO_GENERAL_USER_ID=
# If configured authors mention target, or type Sir/SerSavage variants, bot pings them with a fixed line.
# NOOBMARS_TRIGGER_AUTHOR_IDS=210085436566011904,188328879180480512,405079515765800979
# NOOBMARS_TRIGGER_TARGET_ID=275603696036085760
# NOOBMARS_MENTION_REPLY=Sangnoobs
# Extra-strict delusion-variant fuzzing for this user (default 188328879180480512)
# DELUSION_STRICT_USER_ID=188328879180480512

# gv-general spam watch: same text 3+×, or >N msgs in rolling window (see SPAM_WATCH_VOLUME_MSG_THRESHOLD), paste-wall → redirect;
# DM (French) when strike count hits ≥10 in 5 min OR ≥50 in 1 h; if DM fails, French ping in #miaow
# SPAM_WATCH_USER_ID=1409669933801144453
# SPAM_WATCH_MIAOW_CHANNEL_ID=1168970870287503412
# SPAM_WATCH_VOLUME_WINDOW_MS=3600000
# SPAM_WATCH_VOLUME_MSG_THRESHOLD=20
# SPAM_WATCH_DM_THRESHOLD_5MIN=10
# SPAM_WATCH_DM_THRESHOLD_1H=50
# SPAM_WATCH_DM_WINDOW_5MIN_MS=300000
# SPAM_WATCH_DM_WINDOW_1H_MS=3600000
# Same user: ≥N posts in gv-general within SPAM_WATCH_GV_VOLUME_WINDOW_MS → delete each + repost to SPAM_WATCH_MIAOW_CHANNEL_ID (default 20 / 20 min)
# SPAM_WATCH_GV_VOLUME_WINDOW_MS=1200000
# SPAM_WATCH_GV_VOLUME_THRESHOLD=20

# Comma-separated Tenor/embed/attachment id substrings to block in gv-general (delete + hold + off-topic GIF)
# BLOCKED_MEDIA_IDS=1749001747706566
