# Copy to .env and set your bot token (do not commit .env)
DISCORD_TOKEN=your_bot_token_here
# Optional: custom word list path
# WORDS_FILE=words.txt
# Channel where the bot LISTENS (slurs, off-topic, religion/politics, Soon) = gv-general. Leave unset to use default. Do NOT set to off-topic.
# TRIGGER_CHANNEL_ID=1166738417539887218
# Where bot-moved gv-general messages are reposted (keeps #off-topic chat clean). Default: 1485211311070511225
# MOVED_BY_BOT_CHANNEL_ID=1485211311070511225
# If Chronicus/off-topic education cannot be DM’d after a rule hit, post it here (default 1485211311070511225)
# CHRONICUS_EDUCATION_DM_FALLBACK_CHANNEL_ID=1485211311070511225
# #off-topic ID — Chronicus + “please continue here” still point here (default: 1168446788810842172)
# REDIRECT_CHANNEL_ID=1168446788810842172
# Optional: set to 1 or true to log why messages were skipped (wrong channel, empty content, safe-context, no trigger word)
# DEBUG=1

# gv-general: allow non–English casual banter (FR/ES/DE/IT/PT/NL/PL, …) without English-only false positives. Serious slurs (SPAM_SLUR_TERMS) still apply. Set 0/false to disable.
# MULTILINGUAL_BANTER_BYPASS=1

# Optional: "monkey emoji vs moderation/guild threat" meme reactions in gv-general (default random: 🐒 🐵 🦍 — :monkey: :monkey_face: :gorilla:)
# MONKEY_TROPE_EMOJIS=🐒,🐵,🦍
# MONKEY_TROPE_EMOJI=<:monkey:1234567890123456789>

# Slur response: bot replies with this video (first offense). Use a direct, playable URL (e.g. from your host or CDN).
# If set, VIDEO_URL is used; otherwise VIDEO_PATH (local file path) is used.
# VIDEO_URL=https://example.com/path/to/TMFIAR.mp4
# VIDEO_PATH=C:\Users\serje\Downloads\TMFIAR.mp4

# "Poor … Savage" in gv-general → bot replies with this video (default: assets/The_Way_We_Raid_Gloria_Victis.mp4)
# POOR_SAVAGE_VIDEO_PATH=C:\Users\serje\Downloads\The_Way_We_Raid_Gloria_Victis.mp4

# New member join: post this video in gv-general (default: Knights with sub)
# NEW_ARRIVAL_VIDEO_URL=https://streamable.com/vxi8bu
# Channel to post the welcome video (default: same as TRIGGER_CHANNEL_ID / gv-general)
# GV_GENERAL_CHANNEL_ID=1166738417539887218
# Admin channel that receives join notifications; bot welcomes mentioned user in gv-general when it sees "joined"/"welcome" there
# ADMIN_JOIN_CHANNEL_ID=1166746316999757864

# User ID whose image/GIF posts in off-topic are moved to gv-general. Set in Render only — do not commit real IDs.
# OFFTOPIC_TO_GENERAL_USER_ID=
# Temp voice channels ("join to create"):
# 1) Create one voice channel users join to spawn their own channel (hub).
# 2) Bot creates temp channels under this category and moves users there.
# 3) Temp channel is auto-deleted when empty.
# TEMP_VOICE_TRIGGER_CHANNEL_ID=your_join_to_create_voice_channel_id
# TEMP_VOICE_CATEGORY_ID=1166738417539887216
# Optional channel naming template: {displayName} and {username} are supported.
# TEMP_VOICE_NAME_TEMPLATE={displayName}'s channel
# Optional: register /vc as a guild-scoped slash command for instant availability (recommended).
# If empty, /vc is registered globally and can take up to ~1 hour to appear.
# TEMP_VOICE_COMMAND_GUILD_ID=your_server_id
# Optional startup grace (ms) to avoid duplicate temp-voice actions during Render zero-downtime overlap.
# TEMP_VOICE_STARTUP_GRACE_MS=90000
# Commands in Discord (App Commands only):
# Owner-only: /vc help, /vc rename, /vc limit, /vc transfer
# In-channel member: /vc claim (works only if owner is no longer active in that channel)
# If configured authors mention target, or type Sir/SerSavage variants, bot DMs them with fixed line.
# NOOBMARS_TRIGGER_AUTHOR_IDS=210085436566011904,188328879180480512,405079515765800979
# Optional: restrict "Poor <something>" trigger to these IDs. Empty = all NOOBMARS_TRIGGER_AUTHOR_IDS.
# NOOBMARS_POOR_TRIGGER_AUTHOR_IDS=
# NOOBMARS_TRIGGER_TARGET_ID=275603696036085760
# NOOBMARS_MENTION_REPLY=Sangnoobs
# If Noobmars DM fails (blocked/closed), ping user in this server channel.
# NOOBMARS_DM_FALLBACK_CHANNEL_ID=1485211311070511225
# Extra-strict delusion-variant fuzzing for this user (default 188328879180480512)
# DELUSION_STRICT_USER_ID=188328879180480512

# gv-general spam watch: same text 3+×, or >N msgs in rolling window (see SPAM_WATCH_VOLUME_MSG_THRESHOLD), paste-wall → redirect;
# DM (French) when strike count hits ≥10 in 5 min OR ≥50 in 1 h; if DM fails, French ping in #miaow
# SPAM_WATCH_USER_ID=1409669933801144453
# SPAM_WATCH_MIAOW_CHANNEL_ID=1168970870287503412
# SPAM_WATCH_VOLUME_WINDOW_MS=3600000
# SPAM_WATCH_VOLUME_MSG_THRESHOLD=20
# SPAM_WATCH_DM_THRESHOLD_5MIN=10
# SPAM_WATCH_DM_THRESHOLD_1H=50
# SPAM_WATCH_DM_WINDOW_5MIN_MS=300000
# SPAM_WATCH_DM_WINDOW_1H_MS=3600000
# Same user: ≥N posts in gv-general within SPAM_WATCH_GV_VOLUME_WINDOW_MS → delete each + repost to SPAM_WATCH_MIAOW_CHANNEL_ID (default 20 / 20 min)
# SPAM_WATCH_GV_VOLUME_WINDOW_MS=1200000
# SPAM_WATCH_GV_VOLUME_THRESHOLD=20

# Comma-separated Tenor/embed/attachment id substrings to block in gv-general (delete + hold + off-topic GIF)
# BLOCKED_MEDIA_IDS=1749001747706566

# 4-image scam: (1) 1–4.jpg/png ×4, (2) ≥2× image.jpg, (3) SHA256 match in assets/four-image-scam-hashes.json → delete + Court Jester. Bot needs Manage Messages in every channel. Set 0/false to disable.
# COURT_JESTER_ROLE_ID=1322332947197464606
# FOUR_IMAGE_SCAM_BLOCK=1
# FOUR_IMAGE_SCAM_MIN_DUPLICATE_ATTACHMENTS=2
# Extra hash sets (semicolon-separated; each set = 4 comma-separated sha256 hex)
# FOUR_IMAGE_SCAM_HASH_SET=abc...,def...,ghi...,jkl...

# --- Midland Nation EU (second server) — delete + warn DM + offense log; same text triggers as gv-general holds ---
# Set MIDLAND_EU_GUILD_ID to enable (other Midland vars have defaults if omitted).
# GV_MAIN_GUILD_ID=1166738416654897203
# MIDLAND_EU_GUILD_ID=1045040260268163194
# MIDLAND_EU_MOD_CHANNEL_IDS=1045054231004053564,1097987852358406204
# MIDLAND_EU_OFFENSE_LOG_CHANNEL_ID=1516103168940048444
# MIDLAND_EU_WARN_DM=Don't be too toxic now. I'm watching you, mate.

# --- Midland POWER voice translation (Deepgram → DeepL → ElevenLabs) ---
# Enabled automatically when all three API keys below are set. Bot joins voice channel when a
# Guild Leader / Guild Officer is present; only those roles are transcribed. No slash command.
# MIDLAND_EU_VOICE_CHANNEL_ID=1534254030702776510
# MIDLAND_EU_TRANSLATOR_ROLE_IDS=1045066996259238020,1045067247875530834
# DEEPGRAM_API_KEY=
# DEEPL_AUTH_KEY=
# ELEVENLABS_API_KEY=
# Optional: ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional: ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: DEEPGRAM_MODEL=nova-3
# Optional: MIDLAND_VOICE_SILENCE_MS=900
# When Leaders/Officers speak English, bot translates+speaks these (comma-separated DeepL codes):
# MIDLAND_VOICE_EN_TARGETS=ru,fr,es,de,pl
# Languages (non-English → English TTS): EN, FR, RU, RO, ES, DE, PL, IT,
#   ZH (Mandarin + Traditional Chinese), PT (Portuguese + Brazilian), MS (Malay), VI, TH, KO,
#   SR (Serbian/Montenegrin), HR (Croatian), BS (Bosnian), SL (Slovenian), MK (Macedonian), SQ (Albanian/Kosovo)
# DEBUG=1
